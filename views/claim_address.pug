extends layout

block content
  script.
    $(document).ready(function () {
      const csrfToken = $('#claim-security').data('csrf-token');
      let currentChallenge = null;

      function showClaimAlert(alertClass, title, message) {
        const alert = $('<div>', {
          'class': 'alert alert-' + alertClass + ' alert-dismissible fade show',
          'role': 'alert'
        });
        const close = $('<button>', {
          'class': 'btn-close',
          'type': 'button',
          'data-bs-dismiss': 'alert',
          'aria-label': 'Close'
        });
        alert.append(close);
        alert.append($('<div>').append($('<strong>').text(title)));
        alert.append($('<div>', {'class': 'mt-1'}).text(message));
        $('#claimAlert').empty().append(alert);
        fixFooterHeightAndPosition();
      }

      function clearChallenge() {
        currentChallenge = null;
        $('#challengeId').val('');
        $('#signingMessage').val('');
        $('#signature').val('');
        $('#challengeExpiry').text('');
        $('#claim-signature-step').addClass('d-none');
      }

      async function postJson(url, data) {
        const response = await fetch(url, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {'Content-Type': 'application/json', 'Accept': 'application/json'},
          body: JSON.stringify(Object.assign({csrfToken: csrfToken}, data))
        });
        const body = await response.json().catch(function () {
          return {status: 'failed', message: 'The explorer returned an invalid response'};
        });
        if (!response.ok || body.status !== 'success')
          throw new Error(body.message || 'The request could not be completed');
        return body;
      }

      $('#address, #displayName').on('input', clearChallenge);

      $('#generateChallenge').on('click', async function () {
        const button = $(this);
        button.prop('disabled', true);
        $('#claimAlert').empty();
        clearChallenge();

        try {
          const body = await postJson('/claim/challenge', {
            address: $('#address').val(),
            displayName: $('#displayName').val()
          });
          currentChallenge = body.challenge;
          $('#address').val(currentChallenge.address);
          $('#displayName').val(currentChallenge.displayName);
          $('#challengeId').val(currentChallenge.challengeId);
          $('#signingMessage').val(currentChallenge.message);
          $('#challengeExpiry').text('This one-time message expires at ' + new Date(currentChallenge.expiresAt).toLocaleString() + '.');
          $('#claim-signature-step').removeClass('d-none');
          $('#signingMessage').focus().select();
          showClaimAlert('info', 'Signing message ready', 'Copy the complete message exactly as shown, sign it in your MariaCoin wallet, then paste only the resulting signature below.');
        } catch (err) {
          showClaimAlert('danger', 'Unable to prepare claim', err.message);
        } finally {
          button.prop('disabled', false);
        }
      });

      $('#copySigningMessage').on('click', async function () {
        const message = $('#signingMessage').val();
        try {
          await navigator.clipboard.writeText(message);
          showClaimAlert('success', 'Message copied', 'The exact signing message was copied to your clipboard.');
        } catch (err) {
          $('#signingMessage').focus().select();
          showClaimAlert('warning', 'Copy manually', 'Clipboard access was unavailable. The complete message has been selected for you.');
        }
      });

      $('#claimForm').on('submit', async function (event) {
        event.preventDefault();
        const button = $('#submitClaim');

        if (!currentChallenge) {
          showClaimAlert('warning', 'Generate a signing message', 'Generate a new one-time message before submitting a signature.');
          return;
        }

        button.prop('disabled', true);
        try {
          const body = await postJson('/claim', {
            challengeId: currentChallenge.challengeId,
            address: currentChallenge.address,
            displayName: currentChallenge.displayName,
            signature: $('#signature').val()
          });
          const result = body.claim;
          showClaimAlert('success', result.removed ? 'Display name removed' : 'Address claim saved', result.removed ? 'The explorer will show the wallet address without a self-claimed display name.' : result.displayName + ' is now shown as a self-claimed display name alongside ' + result.address + '.');
          clearChallenge();
        } catch (err) {
          clearChallenge();
          showClaimAlert('danger', 'Claim not saved', err.message + ' Generate a new signing message before trying again.');
        } finally {
          button.prop('disabled', false);
        }
      });

      if (#{settings.shared_pages.page_header.page_title_image.enable_animation} == true && #{settings.claim_address_page.page_header.show_img} == true)
        startRotateElement('img#header-img');
    });
  #claim-security(data-csrf-token=claimCsrfToken)
  .col-xs-12.col-md-12
    if settings.claim_address_page.page_header.show_img == true || settings.claim_address_page.page_header.show_title == true || settings.claim_address_page.page_header.show_description == true
      #page-header-container(style='align-items:' + (settings.claim_address_page.page_header.show_img == true && settings.claim_address_page.page_header.show_title == true && settings.claim_address_page.page_header.show_description == true ? 'flex-start' : 'center'))
        if settings.claim_address_page.page_header.show_img == true
          #header-img-container
            img#header-img(src=(settings.shared_pages.page_header.page_title_image == null || settings.shared_pages.page_header.page_title_image.image_path == null || settings.shared_pages.page_header.page_title_image.image_path == '' ? '/img/page-title-img.png' : settings.shared_pages.page_header.page_title_image.image_path), alt='MariaCoin logo')
        #page-title-container
          if settings.claim_address_page.page_header.show_title == true
            h3#page-title Claim a MariaCoin address
          if settings.claim_address_page.page_header.show_description == true
            .sub-page-header.text-muted Prove control of an indexed MariaCoin address and add a self-claimed public display name.
      .cardSpacer.clearfix

    .alert.alert-warning(role='alert')
      strong Security warning
      p.mb-1.mt-2 Never enter or share your private key or seed phrase. This explorer asks only for a public wallet address, a server-issued message and the signature created by your wallet.
      p.mb-0 Verify that you are using https://explorer.mariacoin.com before signing anything.

    .alert.alert-info(role='alert')
      strong What a claim means
      p.mb-1.mt-2 A valid signature proves that the signer controlled the address when the message was signed. It does not transfer coins and does not grant the explorer access to your wallet.
      p.mb-1 No transaction or network fee is involved.
      p.mb-0 Self-claimed names do not verify a person's identity, company, official status or endorsement. The wallet address remains visible alongside every self-claimed name.

    .card.card-default.border-0.cardSpacer
      .card-header
        strong How to claim an address
      .card-body
        ol.mb-0
          li Enter an indexed transparent MariaCoin address beginning with M and an optional display name.
          li Select Generate one-time signing message.
          li Copy the complete message exactly as shown and use the Sign Message feature in the MariaCoin Core wallet that controls the address.
          li Paste only the resulting Base64 signature into this page.
          li Submit the claim. The one-time message expires after ten minutes and cannot be reused.
        p.mt-3.mb-0 To update a name, repeat these steps with the new name. To remove a name, leave Display name blank and sign the generated removal message.

    .card.card-default.border-0.cardSpacer
      .card-header
        strong Claim address
      .card-body
        #claimAlert
        form#claimForm(autocomplete='off')
          .form-group
            fieldset.entryField
              label.form-label(for='address') Wallet address
              input#address.form-control(type='text', value=(hash == null ? '' : hash), maxlength='50', required='required', spellcheck='false', autocapitalize='off', autocomplete='off', aria-describedby='addressHelp')
              #addressHelp.form-text Only indexed transparent MariaCoin addresses beginning with M can be claimed.
          .form-group
            fieldset.entryField
              label.form-label.mt-3(for='displayName') Display name
              input#displayName.form-control(type='text', value=(claim_name == null ? '' : claim_name), maxlength='40', spellcheck='false', autocomplete='off', aria-describedby='displayNameHelp')
              #displayNameHelp.form-text Maximum 40 characters. Markup, control characters and reserved official terms are rejected. Leave blank to remove an existing name.
          .form-group.mt-3
            button#generateChallenge.btn.btn-primary(type='button')
              span.fa-solid.fa-file-signature.me-2
              | Generate one-time signing message

          #claim-signature-step.d-none.mt-4
            hr
            .form-group
              label.form-label(for='signingMessage') Exact message to sign
              textarea#signingMessage.form-control(rows='10', readonly='readonly', spellcheck='false', aria-describedby='challengeExpiry')
              #challengeExpiry.form-text
              input#challengeId(type='hidden')
            button#copySigningMessage.btn.btn-outline-primary.mt-2(type='button')
              span.fa-solid.fa-copy.me-2
              | Copy complete message
            .form-group
              fieldset.entryField
                label.form-label.mt-3(for='signature') Wallet-generated signature
                input#signature.form-control(type='text', maxlength='128', required='required', spellcheck='false', autocapitalize='off', autocomplete='off', placeholder='Paste only the Base64 signature', aria-describedby='signatureHelp')
                #signatureHelp.form-text The explorer verifies this signature server-side through a narrowly scoped private verifymessage call. Generic RPC remains unavailable publicly.
            .form-group.mt-3
              button#submitClaim.btn.btn-success(type='submit')
                span.fa-solid.fa-shield-halved.me-2
                | Verify and save claim
